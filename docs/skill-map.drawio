        <mxCell id="msh8" value="09&lt;br&gt;Listing and selection: the" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fdf6d8;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1">
