  <diagram id="p4" name="4 · Worked slice: an SSO task">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="800" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="note" value="Page 4 — a worked slice: what an SSO task traverses, end to end.&lt;br&gt;&lt;br&gt;Measured 2026-09-20: all 5 SSO routing cases were correct, 3/3 samples each. Routing was never the problem. The two real gaps were a CONTENT gap (Golden SAML — in a skill that routed correctly and held nothing) and a CHECKLIST gap (state, whose rule lives in a different skill, so an auditor walking this skill&#x27;s checklist was never prompted)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF9B2;strokeColor=none;fontSize=11;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="s_task" value="task: &quot;audit our SSO integration&quot;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="200" width="280" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="s_router" value="sota (router)&lt;br&gt;rule 10: identity infrastructure vs app-level login" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#000000;strokeColor=#000000;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="280" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="s_ia" value="sota-identity-access&lt;br&gt;rules/01 federation protocols" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="440" y="190" width="270" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="s_ia3" value="§3 claim validation at the RP&lt;br&gt;aud · azp · iss · exp · nonce · alg" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="800" y="120" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="s_ia4" value="§4 redirect-URI discipline&lt;br&gt;exact match · no wildcards" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="800" y="190" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="s_ia5" value="§5 PKCE downgrade&lt;br&gt;require S256 — do not merely offer" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="800" y="260" width="300" height="50" as="geometry"/>
        </mxCell>
