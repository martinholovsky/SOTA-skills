          <mxGeometry x="800" y="330" width="300" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="s_cs" value="sota-code-security&lt;br&gt;rules/02 §4 — state / login CSRF" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
