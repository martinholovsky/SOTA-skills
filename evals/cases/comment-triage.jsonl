# comment-triage.jsonl — can a reviewer tell a REAL review comment from a wrong one?
# Adopted instrument: AACR-Bench (Alibaba Aone, Apache-2.0), the dataset behind
# alibaba/open-code-review. 2,145 expert-labelled review comments over 200 PRs, 50
# repositories and 10 languages; label 1 = the comment identifies a real defect,
# label 0 = it does not.
#
# WHY THIS SET EXISTS: this library's audit-precision instruments saturate (30 claims,
# 1.00/1.00 in both arms across nine instruments), so the axis was closed for want of a
# measure that could discriminate — not because precision was proven. This set is
# externally annotated, an order of magnitude larger, and its negatives were produced by
# real reviewers and real models rather than by us.
#
# SELECTION RULE — drawn by seeded shuffle (seed 20260912) over the FULL 2,145 records,
# never by how any model scored on them. The draw is BALANCED BY CONSTRUCTION: 20 label-0
# and 20 label-1, so a constant answer scores exactly 0.500 and the 70/30 base rate of
# the source set cannot flatter either arm. At most 2 cases per pull request, so no
# single PR or repository dominates. A record is skipped only when its file no longer
# fetches at the pinned commit (deleted or force-pushed upstream) -- a reason independent
# of difficulty and of label. Code context is frozen into this file at build time, so the
# fixture is reproducible and does not re-fetch.
#
# COMPOSITION, recorded because it bounds the claim: 28 of 40 comments are AI-authored
# and 12 human (`is_ai_comment`), carried from the source set. A lift here is a lift at
# THAT mix, not a general one.
{"id": "bad_11", "label": 0, "note": "**Typo**: `json.load` should be `json.loads`\n\nChanged from:\n```python\nattrs = json.load(d[\"content_with_weight\"])\n```\n\nto:\n```python\nattrs = json.loads(d[\"content_with_weight\"])\n```\n\nGood fix! `json.load()` is for file objects, while `json.loads()` is for strings.", "path": "graphrag/utils.py", "from_line": 577, "to_line": 577, "lang": "Python", "category": "Code Defect", "context_level": "Diff Level", "is_ai_comment": true, "source_model": "Claude-Code/Claude-4.5-Sonnet", "pr_url": "https://github.com/infiniflow/ragflow/pull/7151", "commit": "f189316eae1c199a5891f7a8bc47d53bb1b5c818", "code": "537\t        except Exception as e:\n538\t            logging.exception(e)\n539\t\n540\t        for ty, ents in smp.items():\n541\t            res[ty].extend(ents)\n542\t    return res\n543\t\n544\t\n545\tdef flat_uniq_list(arr, key):\n546\t    res = []\n547\t    for a in arr:\n548\t        a = a[key]\n549\t        if isinstance(a, list):\n550\t            res.extend(a)\n551\t        else:\n552\t            res.append(a)\n553\t    return list(set(res))\n554\t\n555\t\n556\tasync def rebuild_graph(tenant_id, kb_id):\n557\t    graph = nx.Graph()\n558\t    src_ids = set()\n559\t    flds = [\"entity_kwd\", \"from_entity_kwd\", \"to_entity_kwd\", \"knowledge_graph_kwd\", \"content_with_weight\", \"source_id\"]\n560\t    bs = 256\n561\t    for i in range(0, 1024*bs, bs):\n562\t        es_res = await trio.to_thread.run_sync(lambda: settings.docStoreConn.search(flds, [],\n563\t                                 {\"kb_id\": kb_id, \"knowledge_graph_kwd\": [\"entity\"]},\n564\t                                 [],\n565\t                                 OrderByExpr(),\n566\t                                 i, bs, search.index_name(tenant_id), [kb_id]\n567\t                                 ))\n568\t        # tot = settings.docStoreConn.getTotal(es_res)\n569\t        es_res = settings.docStoreConn.getFields(es_res, flds)\n570\t\n571\t        if len(es_res) == 0:\n572\t            break\n573\t\n574\t        for id, d in es_res.items():\n575\t            assert d[\"knowledge_graph_kwd\"] == \"entity\"\n576\t            src_ids.update(d.get(\"source_id\", []))\n577\t            attrs = json.loads(d[\"content_with_weight\"])\n578\t            entity_kwd = d[\"entity_kwd\"][0] if isinstance(d[\"entity_kwd\"], list) else d[\"entity_kwd\"]   # judge infinity or es output\n579\t            graph.add_node(entity_kwd, **attrs)\n580\t\n581\t    for i in range(0, 1024*bs, bs):\n582\t        es_res = await trio.to_thread.run_sync(lambda: settings.docStoreConn.search(flds, [],\n583\t                                 {\"kb_id\": kb_id, \"knowledge_graph_kwd\": [\"relation\"]},\n584\t                                 [],\n585\t                                 OrderByExpr(),\n586\t                                 i, bs, search.index_name(tenant_id), [kb_id]\n587\t                                 ))\n588\t        # tot = settings.docStoreConn.getTotal(es_res)\n589\t        es_res = settings.docStoreConn.getFields(es_res, flds)\n590\t\n591\t        if len(es_res) == 0:\n592\t            break\n593\t\n594\t        for id, d in es_res.items():\n595\t            assert d[\"knowledge_graph_kwd\"] == \"relation\"\n596\t            src_ids.update(d.get(\"source_id\", []))\n597\t            from_entity_kwd = d[\"from_entity_kwd\"][0] if isinstance(d[\"from_entity_kwd\"], list) else d[\"from_entity_kwd\"]\n598\t            to_entity_kwd = d[\"to_entity_kwd\"][0] if isinstance(d[\"to_entity_kwd\"], list) else d[\"to_entity_kwd\"]\n599\t            if graph.has_node(from_entity_kwd) and graph.has_node(to_entity_kwd):\n600\t                attrs = json.loads(d[\"content_with_weight\"])\n601\t                graph.add_edge(from_entity_kwd, to_entity_kwd, **attrs)\n602\t\n603\t    if len(graph.nodes) == 0:\n604\t        return None\n605\t    src_ids = sorted(src_ids)\n606\t    graph.graph[\"source_id\"] = src_ids\n607\t    return graph"}
{"id": "good_08", "label": 1, "note": "The comment references the old container name `'redisTestContainer'`, but the actual container name is now `'redisTestContainer74'` (defined on line 20). Please update the comment to reflect the current container name for accuracy.\n\n```suggestion\n            // use static name 'redisTestContainer74' so if the container doesn't get removed we don't keep adding more\n```", "path": "src/SignalR/server/StackExchangeRedis/test/Docker.cs", "from_line": 113, "to_line": 113, "lang": "C#", "category": "Maintainability and Readability", "context_level": "File Level", "is_ai_comment": true, "source_model": "Claude-Code/Claude-4.5-Sonnet", "pr_url": "https://github.com/dotnet/aspnetcore/pull/62936", "commit": "2f372e8ff137aa24114269576fc1912f12ff5402", "code": "73\t    }\n74\t\n75\t    private void StartRedis(ILogger logger)\n76\t    {\n77\t        try\n78\t        {\n79\t            Run();\n80\t        }\n81\t        catch (Exception ex)\n82\t        {\n83\t            logger.LogError(ex, \"Error starting redis docker container, retrying.\");\n84\t            Thread.Sleep(1000);\n85\t\n86\t            // Call stop just in case the container somehow started after the timeout so our retry logic doesn't fail\n87\t            RunProcessAndWait(_path, $\"stop {_dockerContainerName}\", \"docker stop\", logger, TimeSpan.FromSeconds(15), out var _);\n88\t            Run();\n89\t        }\n90\t\n91\t        var started = false;\n92\t        var wait = TimeSpan.FromSeconds(30);\n93\t        var stopWatch = new Stopwatch();\n94\t        stopWatch.Start();\n95\t        while (stopWatch.Elapsed < wait)\n96\t        {\n97\t            RunProcessAndWait(_path, $\"logs {_dockerContainerName}\", \"docker logs\", logger, TimeSpan.FromSeconds(5), out var logOutput);\n98\t            if (logOutput.Contains(\"Ready to accept connections\"))\n99\t            {\n100\t                started = true;\n101\t                break;\n102\t            }\n103\t        }\n104\t\n105\t        if (!started)\n106\t        {\n107\t            throw new Exception(\"Redis took too long to start.\");\n108\t        }\n109\t\n110\t        void Run()\n111\t        {\n112\t            // create and run docker container, remove automatically when stopped, map 6379 from the container to 6379 localhost\n113\t            // use static name 'redisTestContainer' so if the container doesn't get removed we don't keep adding more\n114\t            // use redis base docker image\n115\t            // 30 second timeout to allow redis image to be downloaded, should be a rare occurrence, only happening when a new version is released\n116\t            RunProcessAndThrowIfFailed(_path, $\"run --rm -p 6379:6379 --name {_dockerContainerName} -d {_redisImageName}\", \"redis\", logger, TimeSpan.FromMinutes(1));\n117\t        }\n118\t    }\n119\t\n120\t    public void Start(ILogger logger)\n121\t    {\n122\t        logger.LogInformation(\"Starting docker container\");\n123\t\n124\t        // stop container if there is one, could be from a previous test run, ignore failures\n125\t        RunProcessAndWait(_path, $\"stop {_dockerMonitorContainerName}\", \"docker stop\", logger, TimeSpan.FromSeconds(15), out var _);\n126\t        RunProcessAndWait(_path, $\"stop {_dockerContainerName}\", \"docker stop\", logger, TimeSpan.FromSeconds(15), out var output);\n127\t\n128\t        StartRedis(logger);\n129\t\n130\t        // inspect the redis docker image and extract the IPAddress. Necessary when running tests from inside a docker container, spinning up a new docker container for redis\n131\t        // outside the current container requires linking the networks (difficult to automate) or using the IP:Port combo\n132\t        RunProcessAndWait(_path, \"inspect --format=\\\"{{range .NetworkSettings.Networks}}{{.IPAddress}}{{end}}\\\" \" + _dockerContainerName, \"docker ipaddress\", logger, TimeSpan.FromSeconds(5), out output);\n133\t        output = output.Trim().Replace(Environment.NewLine, \"\");\n134\t\n135\t        // variable used by Startup.cs\n136\t        Environment.SetEnvironmentVariable(\"REDIS_CONNECTION\", $\"{output}:6379\");\n137\t\n138\t        var (monitorProcess, monitorOutput) = RunProcess(_path, $\"run -i --name {_dockerMonitorContainerName} --link {_dockerContainerName}:redis --rm redis redis-cli -h redis -p 6379\", \"redis monitor\", logger);\n139\t        monitorProcess.StandardInput.WriteLine(\"MONITOR\");\n140\t        monitorProcess.StandardInput.Flush();\n141\t    }\n142\t\n143\t    public void Stop(ILogger logger)\n144\t    {\n145\t        // Get logs from Redis container before stopping the container\n146\t        RunProcessAndThrowIfFailed(_path, $\"logs {_dockerContainerName}\", \"docker logs\", logger, TimeSpan.FromSeconds(5));\n147\t\n148\t        logger.LogInformation(\"Stopping docker container\");\n149\t        RunProcessAndWait(_path, $\"stop {_dockerMonitorContainerName}\", \"docker stop\", logger, TimeSpan.FromSeconds(15), out var _);\n150\t        RunProcessAndWait(_path, $\"stop {_dockerContainerName}\", \"docker stop\", logger, TimeSpan.FromSeconds(15), out var _);\n151\t    }\n152\t\n153\t    public int RunCommand(string commandAndArguments, string prefix, out string output) =>"}
{"id": "bad_06", "label": 0, "note": "The change adding \"deepseek-r1\" to the model ID check is unnecessary for Azure support and should be reverted.", "path": "src/api/providers/deepseek.ts", "from_line": 26, "to_line": 26, "lang": "TypeScript", "category": "Code Defect", "context_level": "Diff Level", "is_ai_comment": false, "source_model": "", "pr_url": "https://github.com/cline/cline/pull/1808", "commit": "cb4d5c90460885942cbbae0298b95f4ee5682086", "code": "1\timport { Anthropic } from \"@anthropic-ai/sdk\"\n2\timport OpenAI from \"openai\"\n3\timport { withRetry } from \"../retry\"\n4\timport { ApiHandler } from \"../\"\n5\timport { ApiHandlerOptions, DeepSeekModelId, ModelInfo, deepSeekDefaultModelId, deepSeekModels } from \"../../shared/api\"\n6\timport { convertToOpenAiMessages } from \"../transform/openai-format\"\n7\timport { ApiStream } from \"../transform/stream\"\n8\timport { convertToR1Format } from \"../transform/r1-format\"\n9\t\n10\texport class DeepSeekHandler implements ApiHandler {\n11\t\tprivate options: ApiHandlerOptions\n12\t\tprivate client: OpenAI\n13\t\n14\t\tconstructor(options: ApiHandlerOptions) {\n15\t\t\tthis.options = options\n16\t\t\tthis.client = new OpenAI({\n17\t\t\t\tbaseURL: \"https://api.deepseek.com/v1\",\n18\t\t\t\tapiKey: this.options.deepSeekApiKey,\n19\t\t\t})\n20\t\t}\n21\t\n22\t\t@withRetry()\n23\t\tasync *createMessage(systemPrompt: string, messages: Anthropic.Messages.MessageParam[]): ApiStream {\n24\t\t\tconst model = this.getModel()\n25\t\n26\t\t\tconst isDeepseekReasoner = model.id.includes(\"deepseek-reasoner\") || model.id.includes(\"deepseek-r1\")\n27\t\n28\t\t\tlet openAiMessages: OpenAI.Chat.ChatCompletionMessageParam[] = [\n29\t\t\t\t{ role: \"system\", content: systemPrompt },\n30\t\t\t\t...convertToOpenAiMessages(messages),\n31\t\t\t]\n32\t\n33\t\t\tif (isDeepseekReasoner) {\n34\t\t\t\topenAiMessages = convertToR1Format([{ role: \"user\", content: systemPrompt }, ...messages])\n35\t\t\t}\n36\t\n37\t\t\tconst stream = await this.client.chat.completions.create({\n38\t\t\t\tmodel: model.id,\n39\t\t\t\tmax_completion_tokens: model.info.maxTokens,\n40\t\t\t\tmessages: openAiMessages,\n41\t\t\t\tstream: true,\n42\t\t\t\tstream_options: { include_usage: true },\n43\t\t\t\t// Only set temperature for non-reasoner models\n44\t\t\t\t...(model.id === \"deepseek-reasoner\" ? {} : { temperature: 0 }),\n45\t\t\t})\n46\t\n47\t\t\tfor await (const chunk of stream) {\n48\t\t\t\tconst delta = chunk.choices[0]?.delta\n49\t\t\t\tif (delta?.content) {\n50\t\t\t\t\tyield {\n51\t\t\t\t\t\ttype: \"text\",\n52\t\t\t\t\t\ttext: delta.content,\n53\t\t\t\t\t}\n54\t\t\t\t}\n55\t\n56\t\t\t\tif (delta && \"reasoning_content\" in delta && delta.reasoning_content) {\n57\t\t\t\t\tyield {\n58\t\t\t\t\t\ttype: \"reasoning\",\n59\t\t\t\t\t\treasoning: (delta.reasoning_content as string | undefined) || \"\",\n60\t\t\t\t\t}\n61\t\t\t\t}\n62\t\n63\t\t\t\tif (chunk.usage) {\n64\t\t\t\t\tyield {\n65\t\t\t\t\t\ttype: \"usage\",\n66\t\t\t\t\t\tinputTokens: chunk.usage.prompt_tokens || 0, // (deepseek reports total input AND cache reads/writes, see context caching: https://api-docs.deepseek.com/guides/kv_cache) where the input tokens is the sum of the cache hits/misses, while anthropic reports them as separate tokens. This is important to know for 1) context management truncation algorithm, and 2) cost calculation (NOTE: we report both input and cache stats but for now set input price to 0 since all the cost calculation will be done using cache hits/misses)"}
{"id": "bad_05", "label": 0, "note": "Since `BackedEnum` extends `UnitEnum` in PHP, `is_subclass_of($value::class, \\UnitEnum::class)` will return true for both UnitEnum and BackedEnum instances. This means BackedEnum values are also caught by this condition. While `Type::enum()` correctly handles both cases internally, it's better to explicitly exclude BackedEnum to make the intent clearer and avoid potential confusion.\n\n```suggestion\n            \\is_object($value) && is_subclass_of($value::class, \\UnitEnum::class) && !is_subclass_of($value::class, \\BackedEnum::class) => Type::enum($value::class),\n```", "path": "src/Symfony/Component/TypeInfo/TypeFactoryTrait.php", "from_line": 415, "to_line": 415, "lang": "PHP", "category": "Maintainability and Readability", "context_level": "Diff Level", "is_ai_comment": true, "source_model": "GLM-4.7", "pr_url": "https://github.com/symfony/symfony/pull/60956", "commit": "647870557cf275de666557e552e11e9a295b9d4a", "code": "375\t        if ($type->isNullable()) {\n376\t            return $type;\n377\t        }\n378\t\n379\t        return new NullableType($type);\n380\t    }\n381\t\n382\t    public static function fromValue(mixed $value): Type\n383\t    {\n384\t        $type = match ($value) {\n385\t            null => self::null(),\n386\t            true => self::true(),\n387\t            false => self::false(),\n388\t            default => null,\n389\t        };\n390\t\n391\t        if (null !== $type) {\n392\t            return $type;\n393\t        }\n394\t\n395\t        if (\\is_callable($value)) {\n396\t            return Type::callable();\n397\t        }\n398\t\n399\t        if (\\is_resource($value)) {\n400\t            return Type::resource();\n401\t        }\n402\t\n403\t        $type = match (get_debug_type($value)) {\n404\t            TypeIdentifier::INT->value => self::int(),\n405\t            TypeIdentifier::FLOAT->value => self::float(),\n406\t            TypeIdentifier::STRING->value => self::string(),\n407\t            default => null,\n408\t        };\n409\t\n410\t        if (null !== $type) {\n411\t            return $type;\n412\t        }\n413\t\n414\t        $type = match (true) {\n415\t            \\is_object($value) && is_subclass_of($value::class, \\UnitEnum::class) => Type::enum($value::class),\n416\t            \\is_object($value) => \\stdClass::class === $value::class ? self::object() : self::object($value::class),\n417\t            \\is_array($value) => self::builtin(TypeIdentifier::ARRAY),\n418\t            default => null,\n419\t        };\n420\t\n421\t        if (null === $type) {\n422\t            return Type::mixed();\n423\t        }\n424\t\n425\t        if (is_iterable($value)) {\n426\t            /** @var list<BuiltinType<TypeIdentifier::INT>|BuiltinType<TypeIdentifier::STRING>> $keyTypes */\n427\t            $keyTypes = [];\n428\t\n429\t            /** @var list<Type> $valueTypes */\n430\t            $valueTypes = [];\n431\t\n432\t            $i = 0;\n433\t\n434\t            foreach ($value as $k => $v) {\n435\t                $keyTypes[] = self::fromValue($k);\n436\t                $valueTypes[] = self::fromValue($v);\n437\t            }\n438\t\n439\t            if ($keyTypes) {\n440\t                $keyTypes = array_values(array_unique($keyTypes));\n441\t                $keyType = \\count($keyTypes) > 1 ? self::union(...$keyTypes) : $keyTypes[0];\n442\t            } else {\n443\t                $keyType = Type::arrayKey();\n444\t            }\n445\t\n446\t            $valueType = $valueTypes ? CollectionType::mergeCollectionValueTypes($valueTypes) : Type::mixed();\n447\t\n448\t            return self::collection($type, $valueType, $keyType, \\is_array($value) && array_is_list($value));\n449\t        }\n450\t\n451\t        if ($value instanceof \\ArrayAccess) {\n452\t            return self::collection($type);\n453\t        }\n454\t\n455\t        return $type;"}
{"id": "good_04", "label": 1, "note": "Idiomatic Go prefers declaring Mutex as a value rather than a pointer. You can use `var tokenMapLock sync.Mutex`.\nAlso, `tokenSwapMap` can be initialized simply as `var tokenSwapMap = make(map[string]*TokenSwapEntry)` or `var tokenSwapMap = map[string]*TokenSwapEntry{}`.\n", "path": "pkg/util/shellutil/tokenswap.go", "from_line": 16, "to_line": 17, "lang": "Go", "category": "Maintainability and Readability", "context_level": "Diff Level", "is_ai_comment": true, "source_model": "Gemini-3-Pro", "pr_url": "https://github.com/wavetermdev/waveterm/pull/1755", "commit": "61b0fb4baec87c6fa91bdeadc43fab75fd29eb61", "code": "1\t// Copyright 2025, Command Line Inc.\n2\t// SPDX-License-Identifier: Apache-2.0\n3\t\n4\tpackage shellutil\n5\t\n6\timport (\n7\t\t\"encoding/base64\"\n8\t\t\"encoding/json\"\n9\t\t\"fmt\"\n10\t\t\"sync\"\n11\t\t\"time\"\n12\t\n13\t\t\"github.com/wavetermdev/waveterm/pkg/wshrpc\"\n14\t)\n15\t\n16\tvar tokenSwapMap map[string]*TokenSwapEntry = make(map[string]*TokenSwapEntry)\n17\tvar tokenMapLock = &sync.Mutex{}\n18\t\n19\ttype TokenSwapEntry struct {\n20\t\tToken      string             `json:\"token\"`\n21\t\tSockName   string             `json:\"sockname,omitempty\"`\n22\t\tRpcContext *wshrpc.RpcContext `json:\"rpccontext,omitempty\"`\n23\t\tJwtToken   string             `json:\"jwttoken,omitempty\"`\n24\t\tEnv        map[string]string  `json:\"env,omitempty\"`\n25\t\tScriptText string             `json:\"scripttext,omitempty\"`\n26\t\tExp        time.Time          `json:\"-\"`\n27\t}\n28\t\n29\ttype UnpackedTokenType struct {\n30\t\tToken      string             `json:\"token\"` // uuid\n31\t\tSockName   string             `json:\"sockname,omitempty\"`\n32\t\tRpcContext *wshrpc.RpcContext `json:\"rpccontext,omitempty\"`\n33\t}\n34\t\n35\tfunc (t *UnpackedTokenType) Pack() (string, error) {\n36\t\t// convert to json, and then base64 encode\n37\t\tbarr, err := json.Marshal(t)\n38\t\tif err != nil {\n39\t\t\treturn \"\", err\n40\t\t}\n41\t\treturn base64.StdEncoding.EncodeToString(barr), nil\n42\t}\n43\t\n44\tfunc UnpackSwapToken(token string) (*UnpackedTokenType, error) {\n45\t\t// base64 decode, then convert from json\n46\t\tbarr, err := base64.StdEncoding.DecodeString(token)\n47\t\tif err != nil {\n48\t\t\treturn nil, err\n49\t\t}\n50\t\tvar unpacked UnpackedTokenType\n51\t\terr = json.Unmarshal(barr, &unpacked)\n52\t\tif err != nil {\n53\t\t\treturn nil, err\n54\t\t}\n55\t\treturn &unpacked, nil\n56\t}\n57\t"}
