throw Base::ValueError(\"SketchBased: No face selected\");\n768\t\n769\t    if (ref->isDerivedFrom<App::Plane>()) {\n770\t        upToFace = TopoDS::Face(makeShapeFromPlane(ref));\n771\t        return;\n772\t    }\n773\t    else if (ref->isDerivedFrom<PartDesign::Plane>()) {\n774\t        Part::Datum* datum = static_cast<Part::Datum*>(ref);\n775\t        upToFace = TopoDS::Face(datum->getShape());"}
