se::Vector3d org(0.0, 0.0, 0.0);\n1170\t    Base::Vector3d curRot = anchor->getXDirection();\n1171\t    Base::Vector3d curDir = anchor->Direction.getValue();\n1172\t    Base::Vector3d newRot = DrawUtil::vecRotate(curRot, angle, curDir, org);"}
{"id": "good_17", "label": 1, "note": "`postWriteToReplica()` assumes `c->ref_repl_buf_node` is non-NULL. If a replica client can exist before being attached to backlog blocks (or after a reset), `listNodeValue(curr)` will crash. Consider guarding early when `c->ref_repl_buf_node == NULL` or asserting with a clearer invariant.\n\nAlso, `c->nwritten` is used as byte count and added to `c->ref_block_pos`; ensure it is always non-negative and represents bytes actually written (esp. on error paths where it may be negative).", "path": "src/networking.c", "from_line": 2010, "to_line": 2022, "lang": "C", "category": "Code Defect", "context_level": "Diff Level", "is_ai_comment": true, "source_model": "GPT-5.2", "pr_url": "https://github.com/valkey-io/valkey/pull/1485", "commit": "8b2137d6cd7c8b898352b8bcb035402958d92707", "code": "1970\t        if (c->flag.protected_rdb_channel) {\n1971\t            /* Check if it's safe to remove RDB connection protection during synchronization\n1972\t             * The primary gives a grace period before freeing this client because\n1973\t             * it serves as a reference to the first required replication data block for\n1974\t             * this replica */\n1975\t            if (!c->rdb_client_disconnect_time) {\n1976\t                if (c->conn) connSetReadHandler(c->conn, NULL);\n1977\t                c->rdb_client_disconnect_time = server.unixtime;\n1978\t                dualChannelServerLog(LL_VERBOSE, \"Postpone RDB client id=%llu (%s) free for %d seconds\",\n1979\t                                     (unsigned long long)c->id, replicationGetReplicaName(c), server.wait_before_rdb_client_free);\n1980\t            }\n1981\t            if (server.unixtime - c->rdb_client_disconnect_time <= server.wait_before_rdb_client_free) continue;\n1982\t            dualChannelServerLog(\n1983\t                LL_NOTICE,\n1984\t                \"Replica main channel failed to establish PSYNC within the grace period (%ld seconds). \"\n1985\t                \"Freeing RDB client %llu.\",\n1986\t                (long int)(server.unixtime - c->rdb_client_disconnect_time), (unsigned long long)c->id);\n1987\t            c->flag.protected_rdb_channel = 0;\n1988\t        }\n1989\t\n1990\t        if (c->flag.protected) continue;\n1991\t\n1992\t        c->flag.close_asap = 0;\n1993\t        freeClient(c);\n1994\t        listDelNode(server.clients_to_close, ln);\n1995\t        freed++;\n1996\t    }\n1997\t    return freed;\n1998\t}\n1999\t\n2000\t/* Return a client by ID, or NULL if the client ID is not in the set\n2001\t * of registered clients. Note that \"fake clients\", created with -1 as FD,\n2002\t * are not registered clients. */\n2003\tclient *lookupClientByID(uint64_t id) {\n2004\t    id = htonu64(id);\n2005\t    void *c = NULL;\n2006\t    raxFind(server.clients_index, (unsigned char *)&id, sizeof(id), &c);\n2007\t    return c;\n2008\t}\n2009\t\n2010\tstatic void postWriteToReplica(client *c) {\n2011\t    if (c->nwritten <= 0) return;\n2012\t\n2013\t    server.stat_net_repl_output_bytes += c->nwritten;\n2014\t\n2015\t    /* Locate the last node which has leftover data and\n2016\t     * decrement reference counts of all nodes in front of it.\n2017\t     * Set c->ref_repl_buf_node to point to the last node and\n2018\t     * c->ref_block_pos to the offset within that node  */\n2019\t    listNode *curr = c->ref_repl_buf_node;\n2020\t    listNode *next = NULL;\n2021\t    size_t nwritten = c->nwritten + c->ref_block_pos;\n2022\t    replBufBlock *o = listNodeValue(curr);\n2023\t\n2024\t    while (nwritten >= o->used) {\n2025\t        next = listNextNode(curr);\n2026\t        if (!next) break; /* End of list */\n2027\t\n2028\t        nwritten -= o->used;\n2029\t        o->refcount--;\n2030\t\n2031\t        curr = next;\n2032\t        o = listNodeValue(curr);\n2033\t        o->refcount++;\n2034\t    }\n2035\t\n2036\t    serverAssert(nwritten <= o->used);\n2037\t    c->ref_repl_buf_node = curr;\n2038\t    c->ref_bl