p<\n382\t    SettingScope,\n383\t    ReturnType<typeof trackEnvVarMappings>\n384\t  >;\n385\t\n386\t  private _merged: Settings;\n387\t\n388\t  get merged(): Settings {\n389\t    return this._merged;\n390\t  }\n391\t\n392\t  private computeMergedSettings(): Settings {\n393\t    return mergeSettings(\n394\t      this.system.settings,\n395\t      this.systemDefaults.settings,\n396\t      this.user.settings,\n397\t      this.workspace.settings,\n398\t      this.isTrusted,\n399\t    );\n400\t  }\n401\t\n402\t  forScope(scope: SettingScope): SettingsFile {\n403\t    switch (scope) {\n404\t      case SettingScope.User:\n405\t        return this.user;\n406\t      case SettingScope.Workspace:\n407\t        return this.workspace;\n408\t      case SettingScope.System:\n409\t        return this.system;\n410\t      case SettingScope.SystemDefaults:\n411\t        return this.systemDefaults;\n412\t      default:\n413\t        throw new Error(`Invalid scope: ${scope}`);\n414\t    }\n415\t  }\n416\t\n417\t  setValue(scope: SettingScope, key: string, value: unknown): void {\n418\t    const settingsFile = this.forScope(scope);\n419\t    setNestedProperty(settingsFile.settings, key, value);\n420\t    this._merged = this.computeMergedSettings();\n421\t    const envMappings = this.envVarMappings.get(scope) || [];"}
