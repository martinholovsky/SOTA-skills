{"id": "bad_19", "label": 0, "note": "Potential logic/contract mismatch: CopyInternal/CopyRemote now return (bool, error) where bool seems to indicate whether the source is a directory (used by MoveInternal to decide recursive delete). Please confirm fsutil.PrefixCopyInternal/PrefixCopyRemote also return (isDir bool, err error) and that this bool is indeed the correct value to pass into Delete (i.e., Delete expects isDir/recursive flag, not opts.Recursive). If PrefixCopy* returns different semantics (e.g., \"didCopyDir\"), this could cause incorrect delete behavior (deleting non-recursively for dirs or recursively for files).\n\n```suggestion\n isDir, err := c.CopyInternal(ctx, srcConn, destConn, opts)\n \tif err != nil {\n \t\treturn fmt.Errorf(\"error copying blockfile: %w\", err)\n \t}\n \t// Ensure isDir matches Delete's expected recursive/isDir semantics.\n \tif err := c.Delete(ctx, srcConn, isDir /* or opts.Recursive if that is intended */); err != nil {\n```", "path": "pkg/remote/fileshare/wavefs/wavefs.go", "from_line": 425, "to_line": 429, "lang": "Go", "category": "Code Defect", "context_level": "Repo Level", "is_ai_comment": true, "source_model": "GPT-5.2", "pr_url": "https://github.com/wavetermdev/waveterm/pull/1998", "commit": "4b7637fb17fb0f937d67f12a63f3f370a3343117", "code": "385\t\t\tif data.Info != nil {\n386\t\t\t\tif data.Info.Opts != nil {\n387\t\t\t\t\topts = *data.Info.Opts\n388\t\t\t\t}\n389\t\t\t\tif data.Info.Meta != nil {\n390\t\t\t\t\tmeta = *data.Info.Meta\n391\t\t\t\t}\n392\t\t\t}\n393\t\t\tif err := filestore.WFS.MakeFile(ctx, zoneId, fileName, meta, opts); err != nil {\n394\t\t\t\treturn fmt.Errorf(\"error making blockfile: %w\", err)\n395\t\t\t}\n396\t\t}\n397\t\terr = filestore.WFS.AppendData(ctx, zoneId, fileName, dataBuf)\n398\t\tif errors.Is(err, fs.ErrNotExist) {\n399\t\t\treturn fmt.Errorf(\"NOTFOUND: %w\", err)\n400\t\t}\n401\t\tif err != nil {\n402\t\t\treturn fmt.Errorf(\"error writing to blockfile: %w\", err)\n403\t\t}\n404\t\twps.Broker.Publish(wps.WaveEvent{\n405\t\t\tEvent:  wps.Event_BlockFile,\n406\t\t\tScopes: []string{waveobj.MakeORef(waveobj.OType_Block, zoneId).String()},\n407\t\t\tData: &wps.WSFileEventData{\n408\t\t\t\tZoneId:   zoneId,\n409\t\t\t\tFileName: fileName,\n410\t\t\t\tFileOp:   wps.FileOp_Invalidate,\n411\t\t\t},\n412\t\t})\n413\t\treturn nil\n414\t}\n415\t\n416\t// WaveFile does not support directories, only prefix-based listing\n417\tfunc (c WaveClient) Mkdir(ctx context.Context, conn *connparse.Connection) error {\n418\t\treturn errors.ErrUnsupported\n419\t}\n420\t\n421\tfunc (c WaveClient) MoveInternal(ctx context.Context, srcConn, destConn *connparse.Connection, opts *wshrpc.FileCopyOpts) error {\n422\t\tif srcConn.Host != destConn.Host {\n423\t\t\treturn fmt.Errorf(\"move internal, src and dest hosts do not match\")\n424\t\t}\n425\t\tisDir, err := c.CopyInternal(ctx, srcConn, destConn, opts)\n426\t\tif err != nil {\n427\t\t\treturn fmt.Errorf(\"error copying blockfile: %w\", err)\n428\t\t}\n429\t\tif err := c.Delete(ctx, srcConn, isDir); err != nil {\n430\t\t\treturn fmt.Errorf(\"error deleting blockfile: %w\", err)\n431\t\t}\n432\t\treturn nil\n433\t}\n434\t\n435\tfunc (c WaveClient) CopyInternal(ctx context.Context, srcConn, destConn *connparse.Connection, opts *wshrpc.FileCopyOpts) (bool, error) {\n436\t\treturn fsutil.PrefixCopyInternal(ctx, srcConn, destConn, c, opts, func(ctx context.Context, zoneId, prefix string) ([]string, error) {\n437\t\t\tentryList := make([]string, 0)\n438\t\t\tif err := listFilesPrefix(ctx, zoneId, prefix, func(wf *filestore.WaveFile) error {\n439\t\t\t\tentryList = append(entryList, wf.Name)\n440\t\t\t\treturn nil\n441\t\t\t}); err != nil {\n442\t\t\t\treturn nil, err\n443\t\t\t}\n444\t\t\treturn entryList, nil\n445\t\t}, func(ctx context.Context, srcPath, destPath string) error {\n446\t\t\tsrcHost := srcConn.Host\n447\t\t\tsrcFileName := strings.TrimPrefix(srcPath, srcHost+fspath.Separator)\n448\t\t\tdestHost := destConn.Host\n449\t\t\tdestFileName := strings.TrimPrefix(destPath, destHost+fspath.Separator)\n450\t\t\t_, dataBuf, err := filestore.WFS.ReadFile(ctx, srcHost, srcFileName)\n451\t\t\tif err != nil {\n452\t\t\t\treturn fmt.Errorf(\"error reading source blockfile: %w\", err)\n453\t\t\t}\n454\t\t\tif err := filestore.WFS.WriteFile(ctx, destHost, destFileName, dataBuf); err != nil {\n455\t\t\t\treturn fmt.Errorf(\"error writing to destination blockfile: %w\", err)\n456\t\t\t}\n457\t\t\twps.Broker.Publish(wps.WaveEvent{\n458\t\t\t\tEvent:  wps.Event_BlockFile,\n459\t\t\t\tScopes: []string{waveobj.MakeORef(waveobj.OType_Block, destHost).String()},\n460\t\t\t\tData: &wps.WSFileEventData{\n461\t\t\t\t\tZoneId:   destHost,\n462\t\t\t\t\tFileName: destFileName,\n463\t\t\t\t\tFileOp:   wps.FileOp_Invalidate,\n464\t\t\t\t},\n465\t\t\t})\n466\t\t\treturn nil\n467\t\t})\n468\t}\n469\t"}
{"id": "good_09", "label": 1, "note": "The assertion `expect(user.role).toContain('member')` is redundant since the next assertion `expect(user.role).toBe('global:member')` is more specific and already implies the first condition passes. Consider removing the redundant assertion for cleaner and more precise test code.\n", "path": "packages/testing/playwright/tests/ui/user-service.spec.ts", "from_line": 32, "to_line": 37, "lang": "TypeScript", "category": "Maintainability and Readability", "context_level": "Diff Level", "is_ai_comment": true, "source_model": "GLM-4.7", "pr_url": "https://github.com/n8n-io/n8n/pull/20210", "commit": "ebe680fbcacd9210aa219ab01d98012ac1d6faae", "code": "1\timport { expect, test } from '../../fixtures/base';\n2\t\n3\ttest.describe('User API Service', () => {\n4\t\ttest('should create a user with default values', async ({ api }) => {\n5\t\t\tconst user = await api.users.create();\n6\t\n7\t\t\texpect(user.email).toContain('testuser');\n8\t\t\texpect(user.email).toContain('@test.com');\n9\t\t\texpect(user.firstName).toBe('Test');\n10\t\t\texpect(user.lastName).toBe('User');\n11\t\t\texpect(user.role).toContain('member');\n12\t\t});\n13\t\n14\t\ttest('should create a user with custom values', async ({ api }) => {\n15\t\t\tconst customEmail = `custom-${Date.now()}@test.com`;\n16\t\t\tconst customPassword = 'CustomPass123!';\n17\t\n18\t\t\tconst user = await api.users.create({\n19\t\t\t\temail: customEmail,\n20\t\t\t\tpassword: customPassword,\n21\t\t\t\tfirstName: 'John',\n22\t\t\t\tlastName: 'Doe',\n23\t\t\t\trole: 'global:member',\n24\t\t\t});\n25\t\n26\t\t\texpect(user.email.toLowerCase()).toBe(customEmail.toLowerCase());\n27\t\t\texpect(user.firstName).toBe('John');\n28\t\t\texpect(user.lastName).toBe('Doe');\n29\t\t\texpect(user.role).toContain('member');\n30\t\t});\n31\t\n32\t\ttest('should create a member user by default', async ({ api }) => {\n33\t\t\tconst user = await api.users.create();\n34\t\n35\t\t\texpect(user.role).toContain('member');\n36\t\t\texpect(user.role).toBe('global:member');\n37\t\t});\n38\t\n39\t\ttest('should maintain separate sessions for multiple users', async ({ n8n, api }) => {\n40\t\t\tawait n8n.navigate.toPersonalSettings();\n41\t\t\tconst user = await api.users.create();\n42\t\n43\t\t\tawait n8n.page.reload();\n44\t\t\tawait expect(n8n.settingsPersonal.getUserRole()).toHaveText('Owner');\n45\t\n46\t\t\t// New user page should have test name\n47\t\t\tconst memberN8n = await n8n.start.withUser(user);\n48\t\n49\t\t\tawait memberN8n.navigate.toPersonalSettings();\n50\t\t\tawait expect(memberN8n.settingsPersonal.getUserRole()).toHaveText('Member');\n51\t\n52\t\t\t// n8n main should still have owner context\n53\t\t\tawait n8n.page.reload();\n54\t\t\tawait expect(n8n.settingsPersonal.getUserRole()).toHaveText('Owner');\n55\t\n56\t\t\t// user page should still have member role\n57\t\t\tawait memberN8n.page.reload();\n58\t\t\tawait expect(memberN8n.settingsPersonal.getUserRole()).toHaveText('Member');\n59\t\t});\n60\t});"}
{"id": "good_07", "label": 1, "note": "The cleanup loop modifying allocation state via `VULKAN_INTERNAL_CleanCommandBuffer` lacks synchronization with `allocatorLock`, risking race conditions against the allocation check when `checkEmptyAllocations` is enabled.", "path": "src/gpu/vulkan/SDL_gpu_vulkan.c", "from_line": 10548, "to_line": 10548, "lang": "C", "category": "Code Defect", "context_level": "File Level", "is_ai_comment": false, "source_model": "", "pr_url": "https://github.com/libsdl-org/SDL/pull/12718", "commit": "96dfef35c4b0b89f2f8d9c2ecc4f5e3a25d3e7a0", "code": "10508\t            renderer->unifiedQueue,\n10509\t            &presentInfo);\n10510\t\n10511\t        if (presentResult == VK_SUCCESS || presentResult == VK_SUBOPTIMAL_KHR || presentResult == VK_ERROR_OUT_OF_DATE_KHR) {\n10512\t            // If presenting, the swapchain is using the in-flight fence\n10513\t            presentData->windowData->inFlightFences[presentData->windowData->frameCounter] = (SDL_GPUFence*)vulkanCommandBuffer->inFlightFence;\n10514\t            (void)SDL_AtomicIncRef(&vulkanCommandBuffer->inFlightFence->referenceCount);\n10515\t\n10516\t            if (presentResult == VK_SUBOPTIMAL_KHR || presentResult == VK_ERROR_OUT_OF_DATE_KHR) {\n10517\t                presentData->windowData->needsSwapchainRecreate = true;\n10518\t            }\n10519\t        } else {\n10520\t            if (presentResult != VK_SUCCESS) {\n10521\t                VULKAN_INTERNAL_ReleaseCommandBuffer(vulkanCommandBuffer);\n10522\t                SDL_UnlockMutex(renderer->submitLock);\n10523\t            }\n10524\t\n10525\t            CHECK_VULKAN_ERROR_AND_RETURN(presentResult, vkQueuePresentKHR, false);\n10526\t        }\n10527\t\n10528\t        presentData->windowData->frameCounter =\n10529\t            (presentData->windowData->frameCounter + 1) % renderer->allowedFramesInFlight;\n10530\t    }\n10531\t\n10532\t    // If presenting, check if we can perform any cleanups\n10533\t    if (presenting)\n10534\t    {\n10535\t        for (Sint32 i = renderer->submittedCommandBufferCount - 1; i >= 0; i -= 1) {\n10536\t            vulkanResult = renderer->vkGetFenceStatus(\n10537\t                renderer->logicalDevice,\n10538\t                renderer->submittedCommandBuffers[i]->inFlightFence->fence);\n10539\t\n10540\t            if (vulkanResult == VK_SUCCESS) {\n10541\t                VULKAN_INTERNAL_CleanCommandBuffer(\n10542\t                    renderer,\n10543\t                    renderer->submittedCommandBuffers[i],\n10544\t                    false);\n10545\t            }\n10546\t        }\n10547\t\n10548\t        if (renderer->checkEmptyAllocations) {\n10549\t            SDL_LockMutex(renderer->allocatorLock);\n10550\t\n10551\t            for (Uint32 i = 0; i < VK_MAX_MEMORY_TYPES; i += 1) {\n10552\t                allocator = &renderer->memoryAllocator->subAllocators[i];\n10553\t\n10554\t                for (Sint32 j = allocator->allocationCount - 1; j >= 0; j -= 1) {\n10555\t                    if (allocator->allocations[j]->usedRegionCount == 0) {\n10556\t                        VULKAN_INTERNAL_DeallocateMemory(\n10557\t                            renderer,\n10558\t                            allocator,\n10559\t                            j);\n10560\t                    }\n10561\t                }\n10562\t            }\n10563\t\n10564\t            renderer->checkEmptyAllocations = false;\n10565\t\n10566\t            SDL_UnlockMutex(renderer->allocatorLock);\n10567\t        }\n10568\t\n10569\t        VULKAN_INTERNAL_PerformPendingDestroys(renderer);\n10570\t    }\n10571\t\n10572\t    // Mark command buffer as submitted\n10573\t    VULKAN_INTERNAL_ReleaseCommandBuffer(vulkanCommandBuffer);\n10574\t\n10575\t    SDL_UnlockMutex(renderer->submitLock);\n10576\t\n10577\t    return true;\n10578\t}\n10579\t\n10580\tstatic bool VULKAN_Cancel(\n10581\t    SDL_GPUCommandBuffer *commandBuffer)\n10582\t{\n10583\t    VulkanRenderer *renderer;\n10584\t    VulkanCommandBuffer *vulkanCommandBuffer;\n10585\t    VkResult result;\n10586\t\n10587\t    vulkanCommandBuffer = (VulkanCommandBuffer *)commandBuffer;\n10588\t    renderer = vulkanCommandBuffer->renderer;"}
{"id": "bad_14", "label": 0, "note": "`manualOutputDir` is created but never used in this script. If the intent is to emit skipped tests into `../tests/manual`, current logic only skips generation and doesn't write there. Either remove this to avoid confusion, or add logic to generate/write manual tests into `manualOutputDir`.\n\nIf manual tests will be generated, remember to run gofumpt on that directory too (currently only `outputDir` is formatted).", "path": "internal/fourslash/_scripts/convertFourslash.mts", "from_line": 17, "to_line": 17, "lang": "Go", "category": "Maintainability and Readability", "context_level": "File Level", "is_ai_comment": true, "source_model": "GPT-5.2", "pr_url": "https://github.com/microsoft/typescript-go/pull/1446", "commit": "892b4a3f6b701352047ceb019fc0683ab1146bb3", "code": "1\timport * as cp from \"child_process\";\n2\timport * as fs from \"fs\";\n3\timport * as path from \"path\";\n4\timport * as ts from \"typescript\";\n5\timport * as url from \"url\";\n6\timport which from \"which\";\n7\t\n8\tconst stradaFourslashPath = path.resolve(import.meta.dirname, \"../\", \"../\", \"../\", \"_submodules\", \"TypeScript\", \"tests\", \"cases\", \"fourslash\");\n9\t\n10\tlet inputFileSet: Set<string> | undefined;\n11\t\n12\tconst failingTestsPath = path.join(import.meta.dirname, \"failingTests.txt\");\n13\tconst manualTestsPath = path.join(import.meta.dirname, \"manualTests.txt\");\n14\tconst helperFilePath = path.join(import.meta.dirname, \"../\", \"tests\", \"util_test.go\");\n15\t\n16\tconst outputDir = path.join(import.meta.dirname, \"../\", \"tests\", \"gen\");\n17\tconst manualOutputDir = path.join(import.meta.dirname, \"../\", \"tests\", \"manual\");\n18\t\n19\tconst unparsedFiles: string[] = [];\n20\t\n21\tfunction getFailingTests(): Set<string> {\n22\t    const failingTestsList = fs.readFileSync(failingTestsPath, \"utf-8\").split(\"\\n\").map(line => line.trim().substring(4)).filter(line => line.length > 0);\n23\t    return new Set(failingTestsList);\n24\t}\n25\t\n26\tfunction getManualTests(): Set<string> {\n27\t    const manualTestsList = fs.readFileSync(manualTestsPath, \"utf-8\").split(\"\\n\").map(line => line.trim()).filter(line => line.length > 0);\n28\t    return new Set(manualTestsList);\n29\t}\n30\t\n31\texport function main() {\n32\t    const args = process.argv.slice(2);\n33\t    const inputFilesPath = args[0];\n34\t    if (inputFilesPath) {\n35\t        const inputFiles = fs.readFileSync(inputFilesPath, \"utf-8\")\n36\t            .split(\"\\n\").map(line => line.trim())\n37\t            .filter(line => line.length > 0)\n38\t            .map(line => path.basename(line));\n39\t        inputFileSet = new Set(inputFiles);\n40\t    }\n41\t\n42\t    fs.rmSync(outputDir, { recursive: true, force: true });\n43\t    fs.mkdirSync(outputDir, { recursive: true });\n44\t    fs.mkdirSync(manualOutputDir, { recursive: true });\n45\t\n46\t    generateHelperFile();\n47\t    parseTypeScriptFiles(getFailingTests(), getManualTests(), stradaFourslashPath);\n48\t    console.log(unparsedFiles.join(\"\\n\"));\n49\t    const gofmt = which.sync(\"go\");\n50\t    cp.execFileSync(gofmt, [\"tool\", \"mvdan.cc/gofumpt\", \"-lang=go1.24\", \"-w\", outputDir]);\n51\t}\n52\t\n53\tfunction parseTypeScriptFiles(failingTests: Set<string>, manualTests: Set<string>, folder: string): void {\n54\t    const files = fs.readdirSync(folder);\n55\t\n56\t    files.forEach(file => {\n57\t        const filePath = path.join(folder, file);"}
{"id": "bad_03", "label": 0, "note": "Lambda function naming inconsistency: Change `is_request_failed` to `has_request_failed` for consistent predicate naming convention in ZooKeeper request handling logic.", "path": "src/Storages/ObjectStorageQueue/ObjectStorageQueueIFileMetadata.cpp", "from_line": 293, "to_line": 293, "lang": "C++", "category": "Maintainability and Readability", "context_level": "Diff Level", "is_ai_comment": false, "source_model": "", "pr_url": "https://github.com/ClickHouse/ClickHouse/pull/73546", "commit": "40a4654d7b114f1d42f48680d57007ae80897cd1", "code": "253\t\n254\t    LOG_TEST(log, \"File {} has state `{}`: will {}process (processing id version: {})\",\n255\t             path, file_state, success ? \"\" : \"not \",\n256\t             processing_id_version.has_value() ? toString(processing_id_version.value()) : \"None\");\n257\t\n258\t    return success;\n259\t}\n260\t\n261\tvoid ObjectStorageQueueIFileMetadata::resetProcessing()\n262\t{\n263\t    auto state = file_status->state.load();\n264\t    if (state != FileStatus::State::Processing)\n265\t        throw Exception(ErrorCodes::LOGICAL_ERROR, \"Cannot reset non-processing state: {}\", state);\n266\t\n267\t    SCOPE_EXIT({\n268\t        file_status->reset();\n269\t    });\n270\t\n271\t    if (!processing_id_version.has_value())\n272\t    {\n273\t        throw Exception(\n274\t            ErrorCodes::LOGICAL_ERROR,\n275\t            \"No processing id version set, but state is `Processing` ({})\",\n276\t            node_metadata.toString());\n277\t    }\n278\t\n279\t    static constexpr size_t check_processing_id_path_idx = 0;\n280\t    static constexpr size_t remove_processing_id_path_idx = 1;\n281\t    static constexpr size_t remove_processing_path_idx = 2;\n282\t\n283\t    Coordination::Requests requests;\n284\t    requests.push_back(zkutil::makeRemoveRequest(processing_node_id_path, processing_id_version.value()));\n285\t    requests.push_back(zkutil::makeRemoveRequest(processing_node_path, -1));\n286\t\n287\t    Coordination::Responses responses;\n288\t    const auto zk_client = getZooKeeper();\n289\t    const auto code = zk_client->tryMulti(requests, responses);\n290\t    if (code == Coordination::Error::ZOK)\n291\t        return;\n292\t\n293\t    auto is_request_failed = [&](size_t idx)\n294\t    {\n295\t        chassert(idx < responses.size());\n296\t        return responses[idx]->error != Coordination::Error::ZOK;\n297\t    };\n298\t\n299\t    bool unexpected_error = false;\n300\t    std::string failure_reason;\n301\t\n302\t    if (Coordination::isHardwareError(code))\n303\t    {\n304\t        failure_reason = \"Lost connection to keeper\";\n305\t    }\n306\t    else if (is_request_failed(check_processing_id_path_idx))\n307\t    {\n308\t        /// This is normal in case of expired session with keeper.\n309\t        failure_reason = \"Version of processing id node changed\";\n310\t    }\n311\t    else if (is_request_failed(remove_processing_id_path_idx))\n312\t    {\n313\t        /// Remove processing_id node should not actually fail\n314\t        /// because we just checked in a previous keeper request that it exists and has a certain version.\n315\t        unexpected_error = true;\n316\t        failure_reason = \"Failed to remove processing id path\";\n317\t    }\n318\t    else if (is_request_failed(remove_processing_path_idx))\n319\t    {\n320\t        /// This is normal in case of expired session with keeper as this node is ephemeral.\n321\t        failure_reason = \"Failed to remove processing path\";\n322\t    }\n323\t    else\n324\t    {\n325\t        /// Unreachable branch.\n326\t        chassert(false);\n327\t        unexpected_error = true;\n328\t    }\n329\t\n330\t    if (unexpected_error)\n331\t        throw Exception(ErrorCodes::LOGICAL_ERROR, \"{}\", failure_reason);\n332\t\n333\t    LOG_TRACE(log, \"Cannot reset processing for {}. Code: {}. Reason: {}\", path, code, failure_reason);"}
