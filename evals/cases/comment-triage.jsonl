{"id": "bad_08", "label": 0, "note": "State consistency: `renderer->defragInProgress` is set to `1` at the start but is not cleared here on success or any failure path. Verify where it is reset; otherwise defrag may become permanently disabled after first run or after an early return. Also `commandBuffer->isDefrag = 1;` uses integer literal while other changes move to `bool` (`true/false`)—prefer consistent boolean usage if these fields are bools.", "path": "src/gpu/vulkan/SDL_gpu_vulkan.c", "from_line": 10607, "to_line": 10608, "lang": "C", "category": "Code Defect", "context_level": "File Level", "is_ai_comment": true, "source_model": "GPT-5.2", "pr_url": "https://github.com/libsdl-org/SDL/pull/12718", "commit": "96dfef35c4b0b89f2f8d9c2ecc4f5e3a25d3e7a0", "code": "10567\t        }\n10568\t\n10569\t        VULKAN_INTERNAL_PerformPendingDestroys(renderer);\n10570\t    }\n10571\t\n10572\t    // Mark command buffer as submitted\n10573\t    VULKAN_INTERNAL_ReleaseCommandBuffer(vulkanCommandBuffer);\n10574\t\n10575\t    SDL_UnlockMutex(renderer->submitLock);\n10576\t\n10577\t    return true;\n10578\t}\n10579\t\n10580\tstatic bool VULKAN_Cancel(\n10581\t    SDL_GPUCommandBuffer *commandBuffer)\n10582\t{\n10583\t    VulkanRenderer *renderer;\n10584\t    VulkanCommandBuffer *vulkanCommandBuffer;\n10585\t    VkResult result;\n10586\t\n10587\t    vulkanCommandBuffer = (VulkanCommandBuffer *)commandBuffer;\n10588\t    renderer = vulkanCommandBuffer->renderer;\n10589\t\n10590\t    result = renderer->vkResetCommandBuffer(\n10591\t        vulkanCommandBuffer->commandBuffer,\n10592\t        VK_COMMAND_BUFFER_RESET_RELEASE_RESOURCES_BIT);\n10593\t    CHECK_VULKAN_ERROR_AND_RETURN(result, vkResetCommandBuffer, false);\n10594\t\n10595\t    vulkanCommandBuffer->autoReleaseFence = false;\n10596\t    SDL_LockMutex(renderer->submitLock);\n10597\t    VULKAN_INTERNAL_CleanCommandBuffer(renderer, vulkanCommandBuffer, true);\n10598\t    SDL_UnlockMutex(renderer->submitLock);\n10599\t\n10600\t    return true;\n10601\t}\n10602\t\n10603\tstatic bool VULKAN_INTERNAL_DefragmentMemory(\n10604\t    VulkanRenderer *renderer,\n10605\t    VulkanCommandBuffer *commandBuffer)\n10606\t{\n10607\t    renderer->defragInProgress = 1;\n10608\t    commandBuffer->isDefrag = 1;\n10609\t\n10610\t    SDL_LockMutex(renderer->allocatorLock);\n10611\t\n10612\t    VulkanMemoryAllocation *allocation = renderer->allocationsToDefrag[renderer->allocationsToDefragCount - 1];\n10613\t    renderer->allocationsToDefragCount -= 1;\n10614\t\n10615\t    /* For each used region in the allocation\n10616\t     * create a new resource, copy the data\n10617\t     * and re-point the resource containers\n10618\t     */\n10619\t    for (Uint32 i = 0; i < allocation->usedRegionCount; i += 1) {\n10620\t        VulkanMemoryUsedRegion *currentRegion = allocation->usedRegions[i];\n10621\t\n10622\t        if (currentRegion->isBuffer && !currentRegion->vulkanBuffer->markedForDestroy) {\n10623\t            currentRegion->vulkanBuffer->usage |= VK_BUFFER_USAGE_TRANSFER_DST_BIT;\n10624\t\n10625\t            VulkanBuffer *newBuffer = VULKAN_INTERNAL_CreateBuffer(\n10626\t                renderer,\n10627\t                currentRegion->vulkanBuffer->size,\n10628\t                currentRegion->vulkanBuffer->usage,\n10629\t                currentRegion->vulkanBuffer->type,\n10630\t                false,\n10631\t                currentRegion->vulkanBuffer->container != NULL ? currentRegion->vulkanBuffer->container->debugName : NULL);\n10632\t\n10633\t            if (newBuffer == NULL) {\n10634\t                SDL_UnlockMutex(renderer->allocatorLock);\n10635\t                SDL_LogError(SDL_LOG_CATEGORY_GPU, \"%s\", \"Failed to allocate defrag buffer!\");\n10636\t                return false;\n10637\t            }\n10638\t\n10639\t            // Copy buffer contents if necessary\n10640\t            if (\n10641\t                currentRegion->vulkanBuffer->type == VULKAN_BUFFER_TYPE_GPU && currentRegion->vulkanBuffer->transitioned) {\n10642\t                VULKAN_INTERNAL_BufferTransitionFromDefaultUsage(\n10643\t                    renderer,\n10644\t                    commandBuffer,\n10645\t                    VULKAN_BUFFER_USAGE_MODE_COPY_SOURCE,\n10646\t                    currentRegion->vulkanBuffer);\n10647\t\n10648\t                VULKAN_INTERNAL_BufferTransitionFromDefaultUsage("}
{"id": "good_11", "label": 1, "note": "The manual bounds check for salt extraction should be replaced with span-based slicing (`AsSpan(13, saltLength)`) to leverage runtime bounds validation and eliminate error-prone manual length checks.", "path": "src/Identity/Extensions.Core/src/PasswordHasher.cs", "from_line": 260, "to_line": 260, "lang": "C#", "category": "Code Defect", "context_level": "File Level", "is_ai_comment": false, "source_model": "", "pr_url": "https://github.com/dotnet/aspnetcore/pull/62734", "commit": "742f022e92563bd6fb87d1c752f25fd14e1b2a43", "code": "220\t    private static bool VerifyHashedPasswordV2(byte[] hashedPassword, string password)\n221\t    {\n222\t        const KeyDerivationPrf Pbkdf2Prf = KeyDerivationPrf.HMACSHA1; // default for Rfc2898DeriveBytes\n223\t        const int Pbkdf2IterCount = 1000; // default for Rfc2898DeriveBytes\n224\t        const int Pbkdf2SubkeyLength = 256 / 8; // 256 bits\n225\t        const int SaltSize = 128 / 8; // 128 bits\n226\t\n227\t        // We know ahead of time the exact length of a valid hashed password payload.\n228\t        if (hashedPassword.Length != 1 + SaltSize + Pbkdf2SubkeyLength)\n229\t        {\n230\t            return false; // bad size\n231\t        }\n232\t\n233\t        byte[] salt = new byte[SaltSize];\n234\t        Buffer.BlockCopy(hashedPassword, 1, salt, 0, salt.Length);\n235\t\n236\t        byte[] expectedSubkey = new byte[Pbkdf2SubkeyLength];\n237\t        Buffer.BlockCopy(hashedPassword, 1 + salt.Length, expectedSubkey, 0, expectedSubkey.Length);\n238\t\n239\t        // Hash the incoming password and verify it\n240\t        byte[] actualSubkey = KeyDerivation.Pbkdf2(password, salt, Pbkdf2Prf, Pbkdf2IterCount, Pbkdf2SubkeyLength);\n241\t#if NETSTANDARD2_0 || NETFRAMEWORK\n242\t        return ByteArraysEqual(actualSubkey, expectedSubkey);\n243\t#elif NETCOREAPP\n244\t        return CryptographicOperations.FixedTimeEquals(actualSubkey, expectedSubkey);\n245\t#else\n246\t#error Update target frameworks\n247\t#endif\n248\t    }\n249\t\n250\t    private static bool VerifyHashedPasswordV3(byte[] hashedPassword, string password, out int iterCount, out KeyDerivationPrf prf)\n251\t    {\n252\t        const int MaxSaltSize = 1024 * 8; // 8 KiB\n253\t\n254\t        iterCount = default(int);\n255\t        prf = default(KeyDerivationPrf);\n256\t\n257\t        try\n258\t        {\n259\t            // Read header information\n260\t            prf = (KeyDerivationPrf)ReadNetworkByteOrder(hashedPassword, 1);\n261\t            iterCount = (int)ReadNetworkByteOrder(hashedPassword, 5);\n262\t            int saltLength = (int)ReadNetworkByteOrder(hashedPassword, 9);\n263\t\n264\t            // Read the salt: must be >= 128 bits\n265\t            if (saltLength < 128 / 8 || saltLength > MaxSaltSize)\n266\t            {\n267\t                return false;\n268\t            }\n269\t            byte[] salt = new byte[saltLength];\n270\t            Buffer.BlockCopy(hashedPassword, 13, salt, 0, salt.Length);\n271\t\n272\t            // Read the subkey (the rest of the payload): must be >= 128 bits\n273\t            int subkeyLength = hashedPassword.Length - 13 - salt.Length;\n274\t            if (subkeyLength < 128 / 8)\n275\t            {\n276\t                return false;\n277\t            }\n278\t            byte[] expectedSubkey = new byte[subkeyLength];\n279\t            Buffer.BlockCopy(hashedPassword, 13 + salt.Length, expectedSubkey, 0, expectedSubkey.Length);\n280\t\n281\t            // Hash the incoming password and verify it\n282\t            byte[] actualSubkey = KeyDerivation.Pbkdf2(password, salt, prf, iterCount, subkeyLength);\n283\t#if NETSTANDARD2_0 || NETFRAMEWORK\n284\t            return ByteArraysEqual(actualSubkey, expectedSubkey);\n285\t#elif NETCOREAPP\n286\t            return CryptographicOperations.FixedTimeEquals(actualSubkey, expectedSubkey);\n287\t#else\n288\t#error Update target frameworks\n289\t#endif\n290\t        }\n291\t        catch\n292\t        {\n293\t            // This should never occur except in the case of a malformed payload, where\n294\t            // we might go off the end of the array. Regardless, a malformed payload\n295\t            // implies verification failed.\n296\t            return false;\n297\t        }\n298\t    }\n299\t\n300\t    private static uint ReadNetworkByteOrder(byte[] buffer, int offset)"}
